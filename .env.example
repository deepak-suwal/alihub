NODE_ENV=development
PORT=4000

# --- Core infra (docker-compose.dev.yml defaults) ---
DATABASE_URL=postgresql://alihub:alihub@localhost:5433/alihub?schema=public
SHADOW_DATABASE_URL=postgresql://alihub:alihub@localhost:5433/alihub_shadow?schema=public
REDIS_URL=redis://localhost:6380

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret-access
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Alibaba Open Platform (Alihub app, App Console) ---
ALIBABA_APP_KEY=502250
ALIBABA_APP_SECRET=replace-with-app-secret
ALIBABA_OAUTH_REDIRECT_URI=
ALIBABA_GGS_ISV_APP_KEY=502248
ALIBABA_GGS_ISV_APP_SECRET=replace-with-app-secret
ALIBABA_API_BASE_URL=https://openapi-api.alibaba.com/rest
ALIBABA_RATE_LIMIT_PER_SECOND=5

# --- Public origin (gateways redirect the customer back to URLs built from this) ---
# Must be the real public origin in production, e.g. https://alihub.com.np
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Order store (required for real payments) ---
# Without these, orders live in per-instance memory and will not survive the
# redirect to the gateway and back. Checkout refuses to run in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments: eSewa (ePay v2) ---
# Defaults to eSewa's public sandbox (EPAYTEST) when ESEWA_MODE is not "live".
ESEWA_MODE=uat
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Optional endpoint overrides; sensible per-mode defaults are built in.
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

# --- Payments: Khalti (ePayment v2 / KPG-2) ---
# Unset = Khalti is hidden at checkout. Use the sandbox key from a
# test.khalti.com merchant account for KHALTI_MODE=sandbox.
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=

# --- Storage ---
S3_BUCKET=alihub-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Third-party ---
FX_RATE_PROVIDER_API_KEY=
FX_RATE_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SENTRY_DSN=
