NODE_ENV=development
PORT=4000

# --- Core infra (docker-compose.dev.yml defaults) ---
DATABASE_URL=postgresql://alihub:alihub@localhost:5433/alihub?schema=public
SHADOW_DATABASE_URL=postgresql://alihub:alihub@localhost:5433/alihub_shadow?schema=public
REDIS_URL=redis://localhost:6380

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret-access
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Alibaba Open Platform (Alihub app, App Console) ---
ALIBABA_APP_KEY=502250
ALIBABA_APP_SECRET=replace-with-app-secret
ALIBABA_OAUTH_REDIRECT_URI=
ALIBABA_GGS_ISV_APP_KEY=502248
ALIBABA_GGS_ISV_APP_SECRET=replace-with-app-secret
ALIBABA_API_BASE_URL=https://openapi-api.alibaba.com/rest
ALIBABA_RATE_LIMIT_PER_SECOND=5

# --- Payments: ConnectIPS (sign-in via bank-issued PFX cert, see connectips.signer.ts) ---
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_PFX_PATH=
CONNECTIPS_PFX_PASSPHRASE=
CONNECTIPS_BASE_URL=https://uat.connectips.com
CONNECTIPS_MODE=uat

# --- Payments: Fonepay ---
FONEPAY_MERCHANT_CODE=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_SECRET_KEY=
FONEPAY_BASE_URL=https://dev-clientapi.fonepay.com
FONEPAY_MODE=uat

# --- Storage ---
S3_BUCKET=alihub-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Third-party ---
FX_RATE_PROVIDER_API_KEY=
FX_RATE_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SENTRY_DSN=
